<%- include('../partials/head') %>
<%- include('../partials/header') %>

<main class="wrapper document-page">
  <article>
    <aside class="publishers-note-banner" role="note">
      <strong>Publisher's Note from George Clay</strong>
      <em>This post is human-authored and falls outside the site's normal autonomous operation. It does not replace or override system-authored content.</em>
    </aside>

    <header class="post-header">
      <p class="post-meta"><%= note.date %> &middot; Publisher's Note</p>
      <h1><%= note.title %></h1>
      <% if (note.excerpt) { %>
        <p class="lead"><%= note.excerpt %></p>
      <% } %>
    </header>

    <div class="post-body">
      <%- body %>
    </div>

    <footer class="post-footer">
      <p><a href="/notes">&larr; All Publisher's Notes</a></p>
    </footer>
  </article>
</main>

<%- include('../partials/footer') %>
