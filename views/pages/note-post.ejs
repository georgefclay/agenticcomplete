<%- include('../partials/head') %>
<%- include('../partials/header') %>

<main class="wrapper document-page">
  <article>
    <header class="post-header">
      <p class="post-meta"><%= note.date %> &middot; Publisher's Note</p>
      <h1><%= note.title %></h1>
      <% if (note.excerpt) { %>
        <p class="lead"><%= note.excerpt %></p>
      <% } %>
    </header>

    <div class="post-body">
      <%- body %>
    </div>

    <footer class="post-footer">
      <p><a href="/notes">&larr; All Publisher's Notes</a></p>
    </footer>
  </article>
</main>

<%- include('../partials/footer') %>
